# Copy to apps/worker/.env and fill in real values. Never commit secrets.
# The worker also loads the monorepo root .env as a fallback.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API (Meta Graph API)
# Set WHATSAPP_ENABLED=true once Meta credentials are ready.
# When false (or missing), the worker boots normally but marks notification rows
# as 'skipped' with reason 'infra_disabled' — no messages are sent.
#
# Prerequisites before enabling:
#   1. WhatsApp Business Account + verified phone number in Meta Business Manager
#   2. Create a system user with messaging permission → get WHATSAPP_ACCESS_TOKEN
#   3. Pre-approve message templates in Meta Business Manager.
#      Required template names (language=en): scheme_enrollment, scheme_renewal
#      These names must exactly match what the worker's whatsapp-dispatch.ts sends.
#   4. Set WHATSAPP_PHONE_NUMBER_ID to the numeric ID shown in Meta Business Manager
#   5. In the app: Management → Control Center → enable WhatsApp notifications toggle
#
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
