# Copy to .env and fill in real values. Never commit secrets.
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Redis
REDIS_URL=redis://localhost:6379

# Auth — minimum 32 chars in production
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=8h

# Web origins (comma-separated)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# AWS S3 — provision via IAM and rotate regularly
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
S3_BUCKET_NAME=
S3_PRESIGN_EXPIRES=3600

# WhatsApp Cloud API (Meta Graph API) — optional, documented here for reference.
# The API itself never sends messages; only the worker does.
# Set these in the WORKER env (apps/worker/.env) once Meta credentials are ready.
# WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=91

# WhatsApp Webhook (delivery receipts from Meta) — set both once you register
# the callback URL in Meta App Dashboard → Webhooks.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # any secret string you choose in Meta dashboard
# WHATSAPP_WEBHOOK_SECRET=         # app secret from Meta App Dashboard (for HMAC-SHA256)
